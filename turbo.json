{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../rust/**/*.rs",
        "../../rust/**/Cargo.toml",
        "../../rust/**/Cargo.lock",
        "../../rust/rust-toolchain.toml",
        "../../rust/scripts/**"
      ],
      "outputs": ["dist/**", ".svelte-kit/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"]
    }
  }
}
